DOMAIN=xiaoyeai.cn
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://workbuddy:replace-with-a-long-random-password@localhost:5432/workbuddy
AUTH_PEPPER=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-a-different-random-secret
INSTALLATION_TOKEN_PEPPER=replace-with-an-independent-random-secret
# 32 random bytes encoded as Base64 or 64 hexadecimal characters.
API_KEY_ENCRYPTION_KEY=
# Use another independent 32-byte secret for short-lived task payloads.
PAYLOAD_ENCRYPTION_KEY=

IMAGE_PROVIDER=gpt_ge
WORKER_CONCURRENCY=2
# Keep false during the production observation period. Existing users can still log in.
PUBLIC_REGISTRATION_ENABLED=false
# Keep true in production. Set false only for local HTTP development.
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://xiaoyeai.cn
WORKBUDDY_INSTALLER_VERSION=1.2.3
# Public GitHub repository that owns versioned installer releases (owner/repository).
WORKBUDDY_RELEASE_REPOSITORY=shuyejing-cmd/xiaoye_gptimage
# Optional Tencent COS HTTPS directory for the same version. Leave empty to use GitHub only.
WORKBUDDY_RELEASE_BASE_URL=
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
GPT_GE_API_KEY=
GPT_GE_BASE_URL=https://api.gpt.ge/v1

# Existing token is imported into BOOTSTRAP_ADMIN_EMAIL and remains valid for legacy WorkBuddy.
MCP_GATEWAY_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PREFIX=private/workbuddy-images

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=

PORT=3000
SQLITE_PATH=data/tasks.sqlite
ALLOWED_IMAGE_ROOTS=C:/Users/NAME/Pictures
IMAGE_GATEWAY_URL=https://xiaoyeai.cn
IMAGE_API_KEY=
# Compatibility only. New installations should use IMAGE_API_KEY.
IMAGE_GATEWAY_TOKEN=
